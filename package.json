{
	"name": "eumenes-collaboration",
	"version": "0.3.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"contexts",
		".s11tnext",
		"manifest.json",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "bun check",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"lint": "oxlint --deny-warnings",
		"context:lint": "s11tnext lint --release-profile application",
		"context:build": "s11tnext build --release-profile application",
		"context:check": "s11tnext build --check --release-profile application",
		"test": "bun test ./test",
		"verify": "bun run typecheck && bun run format:check && bun run lint && bun run context:lint && bun run context:check && bun test ./test ./example/test && bun run eval:check",
		"pack:check": "bun scripts/pack-check.ts",
		"verify:clean": "bun scripts/verify-clean-copy.ts",
		"work:clean": "bun scripts/clean-work.ts",
		"standalone": "bun standalone/cli.ts",
		"example": "bun example/cli.ts",
		"example:check": "bun test ./example/test",
		"eval:check": "bun eval/check.ts"
	},
	"dependencies": {
		"s11tnext": "0.1.2",
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"typescript": "7.0.2",
		"oxlint": "1.86.0",
		"s11tnext-cli": "0.1.2",
		"@anthropic-ai/claude-agent-sdk": "0.3.289"
	}
}
