+		source: "unregistered",
+		reason: "source_invalid",
+	},
+])(
+	"a host-bound update still rejects $reason on $id",
+	async ({ id, supersedes, source, reason }) => {
+		const h = await harness(({ state, host }) => {
+			const ref = host.sources.at(-1)!.ref;
+			if (!state.facts.length) return [fact("known", "before", ref)];
+			return [
+				fact(id, "after", source === "active" ? ref : source, [...supersedes]),
+			];
+		}, "host-bound");
+		h.handOver({ request: "条件を記録" });
+		h.state.specialist.push(reply);
+		expect((await h.ask("条件を記録")).status).toBe("completed");
+		const session = h.session()!;
+		const before = h.dialogue.specialistCollaborationState(session.id);
+		h.state.specialist.push(reply, reply);
+		expect((await h.ask("条件を訂正")).status).toBe("failed");
+		expect(h.dialogue.specialistCollaborationState(session.id)).toEqual(before);
+		expect(h.state.specialistPrompts.at(-1)?.at(-1)?.content).toContain(reason);
+	},
