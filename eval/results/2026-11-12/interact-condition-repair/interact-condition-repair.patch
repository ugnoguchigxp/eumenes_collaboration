+test("a host-bound correction may omit removals and still replace an existing condition with evidence", async () => {
+	const h = await harness(
+		({ state, host }) => {
+			const ref = host.sources.at(-1)!.ref;
+			return state.facts.length
+				? [fact("period-new", "weekly", ref, ["period"])]
+				: [fact("currency", "JPY", ref), fact("period", "monthly", ref)];
+		},
+		"host-bound",
+		true,
+	);
+	h.handOver({ request: "円で月次集計" });
+	h.state.specialist.push(reply);
+	expect((await h.ask("円で月次集計")).status).toBe("completed");
+	const session = h.session()!;
+	const before = h.dialogue.specialistCollaborationState(
+		session.id,
+	) as CollaborationState;
+	h.state.specialist.push(reply);
+	expect((await h.ask("集計を週次に訂正")).status).toBe("completed");
+	const after = h.dialogue.specialistCollaborationState(
+		session.id,
+	) as CollaborationState;
+	expect(after.facts.find(({ id }) => id === "currency")).toEqual(
+		before.facts[0],
+	);
+	expect(after.facts.find(({ id }) => id === "period")?.status).toBe(
+		"retracted",
+	);
+	expect(after.facts.find(({ id }) => id === "period-new")?.value).toBe(
+		"weekly",
+	);
+	expect(h.state.specialistPrompts).toHaveLength(2);
+});
+
