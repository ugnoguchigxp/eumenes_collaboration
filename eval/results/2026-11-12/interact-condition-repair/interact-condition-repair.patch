+
+export function bindStateChanges(
+	snapshot: ReturnType<typeof collaborationSnapshot>,
+	changes:
+		| Partial<
+				Pick<
+					import("eumenes-collaboration").StateProposal,
+					"upserts" | "removals"
+				>
+		  >
+		| null
+		| undefined,
+) {
+	const existing = new Set(snapshot.state.facts.map(({ id }) => id));
+	return {
+		...stateUpdateBase(snapshot),
+		// An existing ID is updated in place. A redundant self-link has no lineage to record.
+		upserts: (changes?.upserts ?? []).map((fact) =>
+			existing.has(fact.id) && fact.supersedes.includes(fact.id)
+				? {
+						...fact,
+						supersedes: fact.supersedes.filter((id) => id !== fact.id),
+					}
+				: fact,
+		),
+		removals: changes?.removals ?? [],
+	};
+}
