diff --git a/api/application/collaboration/pipeline-review-correction.test.ts b/api/application/collaboration/pipeline-review-correction.test.ts
new file mode 100644
index 0000000..c0e69a4
--- /dev/null
+++ b/api/application/collaboration/pipeline-review-correction.test.ts
@@ -0,0 +1,275 @@
+import { expect, test } from "bun:test";
+import { waitFor } from "../../infrastructure/wait-for";
+import { searchThenDelegate } from "../toolchain/conversation-script.fixture";
+import { harness } from "../toolchain/toolchain.fixture";
+
+const opening =
+	"20秒のタイマー手順を作ってください。実行前に担当者が画面で確認できる形にしてください。";
+const correction = "時間だけ35秒にしてください。";
+const condition = "タイマーは35秒";
+const retained = "実行前に担当者が画面で確認する";
+const oldNotice = "旧版の結果です。";
+const newNotice = "35秒の版を確認しました。";
+const ref = (content: string, key: string) =>
+	JSON.parse(
+		content
+			.split("\n")
+			.find((line) => line.startsWith(key + "="))!
+			.slice(key.length + 1),
+	);
+
+test("a correction during Quick rejects the late old evaluation and presents the new version once", async () => {
+	const started = Promise.withResolvers<void>();
+	const releaseOld = Promise.withResolvers<void>();
+	const released = Promise.withResolvers<void>();
+	const reviewInputs: {
+		revision: number;
+		digest: string;
+		conditions: { id: string; text: string }[];
+		task: string;
+	}[] = [];
+	const noticeVersions: number[] = [];
+	let correcting = false;
+	const h = await harness({
+		pipelines: true,
+		timers: true,
+		discoveryTarget: () => "collaborate_pipeline",
+		firstRound: (_tools, _question, messages) =>
+			searchThenDelegate(
+				(card) => card.id === "collaboration.pipeline",
+				opening,
+				{
+					announcement: "一緒に手順を作ります。",
+					impact: "create",
+				},
+			)(messages),
+		async workflowReview(messages) {
+			const input = JSON.parse(messages.at(-1)!.content);
+			const workflow = input.evidence.find(
+				(entry: { id: string }) => entry.id === "workflow",
+			);
+			const revision = Number(input.target.version);
+			reviewInputs.push({
+				revision,
+				digest: input.target.digest,
+				conditions: input.conditions,
+				task: workflow.document.steps[0].task,
+			});
+			if (revision === 1) {
+				started.resolve();
+				await releaseOld.promise;
+				released.resolve();
+			}
+			const evidence = [
+				{
+					evidenceId: "workflow",
+					startLine: null,
+					endLine: null,
+					pointer: "/steps/0/task",
+				},
+			];
+			return {
+				findings: [],
+				scopeChecks: [
+					{ evidenceId: "workflow", status: "checked", reason: null },
+				],
+				conditionChecks: input.conditions.map(({ id }: { id: string }) => ({
+					conditionId: id,
+					status: "satisfied",
+					reason: "対象版を照合",
+					evidence,
+				})),
+			};
+		},
+		specialist(messages) {
+			const reference = ref(messages[1]!.content, "REFERENCE");
+			const event = (reference.workContext ?? reference.currentWork)?.hostEvent;
+			if (event) {
+				noticeVersions.push(event.revision);
+				expect(event.status).toBe("completed");
+				return {
+					action: "reply",
+					text: event.revision === 1 ? oldNotice : newNotice,
+				};
+			}
+			const revision = Number(
+				/CURRENT_DOCUMENT path=pipeline\.json revision=(\d+)/.exec(
+					messages[1]!.content,
+				)?.[1],
+			);
+			const { host } = ref(messages[1]!.content, "SOURCE_REGISTRY");
+			const sourceRefs = [host.sources.at(-1).ref];
+			const fact = (id: string, value: string, supersedes: string[] = []) => ({
+				id,
+				kind: "condition",
+				status: "confirmed",
+				value,
+				sourceRefs,
+				supersedes,
+			});
+			const stateUpdate = (upserts: unknown[]) => ({
+				upserts,
+				removals: [],
+			});
+			const toolResult = messages.find((message) =>
+				message.content.startsWith("TOOL_RESULT="),
+			);
+			if (toolResult) {
+				const saved = JSON.parse(
+					toolResult.content.slice("TOOL_RESULT=".length),
+				);
+				expect(saved).toMatchObject({
+					ok: true,
+					result: { revision: revision + 1 },
+				});
+				return {
+					action: "invoke",
+					tool: "collaboration.pipeline.review",
+					arguments: { expectedRevision: saved.result.revision },
+					text: "下書きを保存し、評価を始めました。",
+					stateUpdate: stateUpdate([]),
+				};
+			}
+			if (correcting) {
+				return {
+					action: "invoke",
+					tool: "doc.edit",
+					arguments: {
+						baseRevision: revision,
+						edits: [
+							{
+								old: "20秒のタイマーを作る",
+								new: "35秒のタイマーを作る",
+							},
+						],
+					},
+					stateUpdate: stateUpdate([
+						fact("duration-current", condition, ["duration-original"]),
+					]),
+				};
+			}
+			return {
+				action: "invoke",
+				tool: "doc.write",
+				arguments: {
+					baseRevision: revision,
+					title: "タイマーの手順",
+					content: {
+						request: opening,
+						steps: [
+							{
+								id: "timer",
+								bundle: "timers.manage",
+								from: ["request"],
+								task: "20秒のタイマーを作る",
+								result: retained,
+							},
+						],
+						output: { from: ["timer"], deliver: "確認できる手順を渡す" },
+					},
+				},
+				stateUpdate: stateUpdate([
+					fact("duration-original", "タイマーは20秒"),
+					fact("screen", retained),
+				]),
+			};
+		},
+	});
+	async function send(text: string) {
+		const response = await h.request("/api/runs", {
+			requestId: crypto.randomUUID(),
+			conversationId: "main",
+			text,
+		});
+		expect(response.status).toBe(202);
+		const run = await response.json();
+		const done = await h.dialogue.waitForTerminal(run.id, { timeoutMs: 6000 });
+		expect(done?.status, JSON.stringify(done)).toBe("completed");
+		return run.id;
+	}
+	try {
+		const saved = h.settings.get();
+		saved.routes.llm.mode = "larm-preferred";
+		await h.settings.apply({
+			requestId: crypto.randomUUID(),
+			expectedRevision: saved.revision,
+			settings: saved,
+			keys: [],
+		});
+		const openingRun = await send(opening);
+		expect(h.dialogue.answerText(openingRun)).toBe(
+			"下書きを保存し、評価を始めました。",
+		);
+		await waitFor(() => reviewInputs.length === 1, { timeout: 5000 });
+		await started.promise;
+		const session = h.dialogue.specialistSession("main")!;
+		const before = h.dialogue.specialistCollaborationState(session.id) as {
+			facts: { id: string; status: string; sourceRefs: string[] }[];
+		};
+		correcting = true;
+		await send(correction);
+		releaseOld.resolve();
+		await released.promise;
+		const messages = () => h.conversation.get("main").messages;
+		await waitFor(
+			() => messages().some((message) => message.text === newNotice),
+			{ timeout: 5000 },
+		);
+		await waitFor(() => h.queue.stats().openJobs === 0, { timeout: 5000 });
+		expect(noticeVersions).toEqual([2]);
+		expect(
+			messages().filter((message) => message.text === newNotice),
+		).toHaveLength(1);
+		expect(
+			messages().filter((message) => message.text === oldNotice),
+		).toHaveLength(0);
+		expect(reviewInputs.map((input) => input.revision)).toEqual([1, 2]);
+		expect(reviewInputs[1]).toMatchObject({
+			task: "35秒のタイマーを作る",
+			conditions: expect.arrayContaining([
+				expect.objectContaining({ id: "duration-current", text: condition }),
+				expect.objectContaining({ id: "screen", text: retained }),
+			]),
+		});
+		const work = h.store.read((db) =>
+			h.toolchain.collaboration.works.view(
+				db,
+				"pipeline",
+				"main",
+				session.workRef,
+			),
+		);
+		expect(work).toMatchObject({
+			revision: 2,
+			document: {
+				request: opening,
+				steps: [
+					{ id: "timer", task: "35秒のタイマーを作る", result: retained },
+				],
+			},
+			current: {
+				review: {
+					revision: 2,
+					status: "completed",
+					result: { target: { version: "2", digest: reviewInputs[1]!.digest } },
+				},
+			},
+		});
+		const after = h.dialogue.specialistCollaborationState(session.id) as {
+			facts: { id: string; status: string; sourceRefs: string[] }[];
+		};
+		expect(after.facts.find(({ id }) => id === "screen")).toEqual(
+			before.facts.find(({ id }) => id === "screen"),
+		);
+		expect(
+			after.facts.find(({ id }) => id === "duration-original")?.status,
+		).toBe("retracted");
+		expect(
+			after.facts.find(({ id }) => id === "duration-current")?.status,
+		).toBe("confirmed");
+		expect(h.timers!.list().items).toHaveLength(0);
+	} finally {
+		releaseOld.resolve();
+		await h.close();
+	}
+}, 20_000);
