+			const { signal, current } = await started.promise;
+			expect(store.read(current)).toBe(true);
+			await store.write((db) => {
+				if (change === "epoch") {
+					epoch++;
+					return;
+				}
+				if (change === "forget") {
+					works.forget(db, ["message-review"]);
+					return;
