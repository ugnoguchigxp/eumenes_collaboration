        "observed": [
          "EMBARGO",
          "P-03",
          "一致。CONTENT/PUBLICは有効だが、解禁時刻は2026-11-1303:00Z（12:00JST）で、基準時刻と同時のため解禁済みではなく、条件上同時なら解禁済み。"
        ],
        "fields": [
          false,
          false,
          false
        ],
        "correct": false
      },
