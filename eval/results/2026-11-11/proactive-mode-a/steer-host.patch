+import { createSteeringInbox } from "eumenes-steer";
+import type { SteeringBatch, SteeringEvent } from "eumenes-steer";
+import type { TurnInput } from "./specialist-turn";
+
+type Scope = Pick<TurnInput, "conversationId" | "runId" | "sessionId" | "epoch">;
+type Source = Scope & { ref: string; revision: string; text: string };
+const inbox = createSteeringInbox();
+type Sender = { scope: Scope; store(source: Source): void; enqueue(event: SteeringEvent, generation?: string): string };
+let trial: { conversationId: string; onOpen(sender: Sender): void } | undefined;
+
+/** Isolated harness seam. The fixture commits synthetic sources before enqueueing references. */
+export function configureTrialSteering(value: typeof trial) { trial = value; }
+
+export function openTrialSteering(scope: Scope) {
+  if (trial?.conversationId !== scope.conversationId) return;
+  const generation = String(scope.epoch);
+  const opened = inbox.open(scope.runId, generation);
+  if (opened.status !== "opened") throw new Error(opened.status);
+  const { target } = opened;
+  const sources = new Map<string, Source>();
+  const matches = (source: Scope) =>
+    source.runId === scope.runId && source.sessionId === scope.sessionId &&
+    source.conversationId === scope.conversationId && source.epoch === scope.epoch;
+  const active: Array<{source: Source; expiresAt: number}> = [];
+  try {
+    trial.onOpen({
+      scope,
+      store(source) { sources.set(source.ref, { ...source }); },
+      enqueue(event, epoch = generation) { return inbox.enqueue(scope.runId, epoch, event).status; },
+    });
+  } catch (error) {
+    target.close();
+    throw error;
+  }
+  const finish = (batch: SteeringBatch | undefined, outcome: "committed" | "unknown") => {
+    if (batch) target.settle(batch.id, outcome);
+  };
+  return {
+    close: () => target.close(),
+    claim(boundary: number, isLast: boolean) {
+      if (isLast) target.seal();
+      const claimed = target.claim(String(boundary));
+      if (claimed.status !== "claimed") return { batch: undefined, supplements: [] };
+      const accepted = claimed.batch.events.flatMap((event) => {
+        const source = sources.get(event.sourceRef);
+        return source && matches(source) && source.revision === event.sourceRevision &&
+          Date.now() < event.expiresAt ? [{ source, expiresAt: event.expiresAt }] : [];
+      });
+      if (accepted.reduce((n, item) => n + Buffer.byteLength(item.source.text, "utf8"), 0) > 1800) {
+        target.settle(claimed.batch.id, "released");
+        return { batch: undefined, supplements: [] };
+      }
+      active.push(...accepted);
+      return { batch: claimed.batch, supplements: accepted.map(({ source: { ref, revision, text } }) => ({ ref, revision, text })) };
+    },
+    finish,
+    assertSources() {
+      if (active.some(({source, expiresAt}) => {
+        const current = sources.get(source.ref);
+        return Date.now() >= expiresAt || !current || !matches(current) || current.revision !== source.revision || current.text !== source.text;
+      })) throw new Error("steer_source_changed");
+    },
+  };
+}
